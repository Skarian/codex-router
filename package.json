  },
  "engines": {
    "node": "^20.17.0 || >=22.9.0"
  },
  "dependencies": {
    "file-type": "21.3.4",
    "fs-native-extensions": "1.5.1",
    "sendblue": "3.15.0",
    "smol-toml": "^1.4.2",
    "valibot": "1.5.0",
    "write-file-atomic": "7.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/write-file-atomic": "4.0.3",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
