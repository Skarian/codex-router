{
  "name": "codex-router",
  "version": "0.1.0",
  "private": true,
  "description": "Route text, messages, and files to trusted Codex tasks by local alias.",
  "type": "module",
  "bin": {
    "codex-router": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
