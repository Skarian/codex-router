{
  "name": "@skarian/codex-router",
  "version": "0.2.1",
  "description": "Route messages to Codex chats through the CLI, SendBlue, or HTTP with SSE.",
  "type": "module",
  "bin": {
    "codex-router": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "docs/*.md",
    "examples/esp32-https"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": "^20.17.0 || >=22.9.0"
  },
  "dependencies": {
    "file-type": "21.3.4",
    "fs-native-extensions": "1.5.1",
    "sendblue": "3.15.0",
    "smol-toml": "^1.4.2",
    "valibot": "1.5.0",
    "write-file-atomic": "7.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/write-file-atomic": "4.0.3",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Skarian/codex-router.git"
  },
  "homepage": "https://github.com/Skarian/codex-router#readme",
  "bugs": {
    "url": "https://github.com/Skarian/codex-router/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
